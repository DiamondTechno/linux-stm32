 * (Globaltech GLT0557201280IS1, Ilitek ILI9881C controller,
 *  Ilitek ILI2520 capacitive touch)
 */

/dts-v1/;

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pwm/pwm.h>
#include "stm32mp-dec-kit.dts"

/ {
	model = "Diamond Technologies STM32MP257F DEC Kit with 5.5-in MIPI DSI Display";

	panel_dsi_backlight: panel-dsi-backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm12 1 1000000 0>;
		brightness-levels = <0 100>;
		num-interpolated-steps = <100>;
		default-brightness-level = <80>;
		power-supply = <&scmi_v3v3>;
		status = "okay";
	};
};

&i2c2 {
	dsi_touchscreen@41 {
		compatible = "ilitek,ili2520";
		reg = <0x41>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_dsi_touchscreen>;
		reset-gpios = <&pca9555_20 4 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpiob>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
		touchscreen-swapped-x-y;
		touchscreen-inverted-x;
		wakeup-source;
	};
};

&ltdc {
	default-on;
	rotation-memory = <&ltdc_sec_rotation>;
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		ltdc_ep0_out: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&dsi_in>;
		};
	};
};

&dsi {
	vdd-supply = <&scmi_vddcore>;
	vdda18-supply = <&scmi_v1v8>;
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dsi_in: endpoint {
				remote-endpoint = <&ltdc_ep0_out>;
			};
		};

		port@1 {
			reg = <1>;
			dsi_out: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&panel_in>;
			};
		};
	};

	panel@0 {
		compatible = "globaltech,glt0557201280is1", "ilitek,ili9881c";
		reg = <0>;
		reset-gpios = <&pca9555_20 3 GPIO_ACTIVE_LOW>;
		backlight = <&panel_dsi_backlight>;
		power-supply = <&scmi_v3v3>;
		status = "okay";

		port {
			panel_in: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&timers12 {
	/delete-property/pinctrl-names;
	/delete-property/pinctrl-0;
	/delete-property/pinctrl-1;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";

	pwm12: pwm {
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&tim12_pwm_pins_mx>;
		pinctrl-1 = <&tim12_pwm_sleep_pins_mx>;
		status = "okay";
	};
};

&pinctrl {
	pinctrl_dsi_touchscreen: pinctrl_dsi_touchscreen-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 3, GPIO)>; /* DSICT_nINT */
		};
	};

	tim12_pwm_pins_mx: tim12_pwm_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('F', 8, AF9)>; /* TIM12_CH2 */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};

	tim12_pwm_sleep_pins_mx: tim12_pwm_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('F', 8, ANALOG)>;
		};
	};
};
