/*
 * Copyright (C) 2026 Diamond Technologies
 *
 * Diamond Technologies STM32MP257F DEC Kit with 10.1" LVDS Display
 * (BOE EV121WXM-N10-1850, 1280x800, MAX25221-backed VDD via 00314 boost)
 */

/dts-v1/;

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pwm/pwm.h>
#include "stm32mp-dec-kit.dts"

/ {
	model = "Diamond Technologies STM32MP257F DEC Kit with 10.1-in LVDS Display";

	panel_lvds_backlight: panel-lvds-backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm10 0 1000000 0>;
		brightness-levels = <0 100>;
		num-interpolated-steps = <100>;
		default-brightness-level = <80>;
		power-supply = <&scmi_v3v3>;
		status = "okay";
	};

	reg_lvds_i2c_switch: regulator-lvds-i2c-switch {
		compatible = "regulator-fixed";
		regulator-name = "lvds_i2c_sw";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&pca9555_20 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		status = "okay";
	};

	reg_lvds_vdd_00314: regulator-lvds-vdd {
		compatible = "regulator-fixed";
		regulator-name = "lvds_vdd";
		/* 00314 boosts 1.8 V input to 3.3 V output */
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pca9555_20 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		vin-supply = <&reg_lvds_i2c_switch>;
		status = "okay";
	};

	panel_lvds: panel-lvds {
		compatible = "boe,ev121wxm-n10-1850";
		backlight = <&panel_lvds_backlight>;
		power-supply = <&DISPLAY_reg>;
		status = "okay";

		port {
			panel_lvds_in: endpoint {
				remote-endpoint = <&lvds_out0>;
			};
		};
	};
};

&i2c2 {
	/* eeprom on display */
	eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <16>;
		status = "okay";
	};

	max25221: max25221@21 {
		compatible = "maxim,max25221";
		reg = <0x21>;
		lcd-supply = <&reg_lvds_vdd_00314>;
		status = "okay";

		regulators {
			DISPLAY_reg: DISPLAY {
				regulator-name = "DISPLAY";
			};
		};
	};

	touchscreen@41 {
		compatible = "ilitek,ili251x";
		reg = <0x41>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_lvds_touchscreen>;
		interrupt-parent = <&gpiob>;
		interrupts = <6 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pca9555_20 6 GPIO_ACTIVE_LOW>;
	};
};

&ltdc {
	default-on;
	rotation-memory = <&ltdc_sec_rotation>;
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		ltdc_ep0_out: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&dsi_in>;
		};

		ltdc_ep1_out: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&lvds_in>;
		};
	};
};

&lvds {
	default-on;
	vdd-supply = <&scmi_vddcore>;
	vdda18-supply = <&scmi_v1v8>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			lvds_in: endpoint {
				remote-endpoint = <&ltdc_ep1_out>;
			};
		};

		port@1 {
			reg = <1>;
			lvds_out0: endpoint {
				remote-endpoint = <&panel_lvds_in>;
			};
		};
	};
};

/* DSI port endpoint kept wired (peer of ltdc_ep0_out) but DSI itself stays
 * disabled — the LVDS path drives the panel. Mirrors the cargt -glt1011280800
 * overlay which configures ports@0 of &dsi without enabling the controller.
 */
&dsi {
	vdd-supply = <&scmi_vddcore>;
	vdda18-supply = <&scmi_v1v8>;
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dsi_in: endpoint {
				remote-endpoint = <&ltdc_ep0_out>;
			};
		};
	};
};

&timers10 {
	/delete-property/pinctrl-names;
	/delete-property/pinctrl-0;
	/delete-property/pinctrl-1;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";

	pwm10: pwm {
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&tim10_pwm_pins_mx>;
		pinctrl-1 = <&tim10_pwm_sleep_pins_mx>;
		status = "okay";
	};
};

&pinctrl {
	pinctrl_lvds_touchscreen: pinctrl_lvds_touchscreen-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 6, GPIO)>; /* LVDSCT_nINT */
		};
	};

	tim10_pwm_pins_mx: tim10_pwm_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 9, AF9)>;
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};

	tim10_pwm_sleep_pins_mx: tim10_pwm_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 9, ANALOG)>;
		};
	};
};
